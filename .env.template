# ─── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=LinkedInAI
MYSQL_USER=linkedinai_app
MYSQL_PASSWORD=linkedinai_pass

# ─── .NET API ──────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=LinkedInAI;User=linkedinai_app;Password=linkedinai_pass;

# JWT
Jwt__Key=your-super-secret-jwt-key-min-32-chars-change-me
Jwt__Issuer=LinkedInAI
Jwt__Audience=LinkedInAI
Jwt__ExpiryMinutes=15
Jwt__RefreshExpiryDays=30

# Google OAuth
Google__ClientId=your-google-client-id
Google__ClientSecret=your-google-client-secret
Google__CallbackUrl=http://localhost:3000/auth/callback?provider=google

# LinkedIn OAuth
LinkedIn__ClientId=your-linkedin-client-id
LinkedIn__ClientSecret=your-linkedin-client-secret
LinkedIn__CallbackUrl=http://localhost:3000/auth/callback?provider=linkedin

# Redis
Redis__ConnectionString=redis:6379

# RabbitMQ
RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest

# Frontend
Frontend__BaseUrl=http://localhost:3000

# ─── Python AI Service ─────────────────────────────────────────────────────────
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
SPACY_MODEL=en_core_web_sm
